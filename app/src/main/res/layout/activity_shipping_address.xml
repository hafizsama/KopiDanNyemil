<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7ED"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alamat Pengiriman"
            android:textColor="#70452F"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lengkapi informasi penerima untuk pengiriman pesananmu."
            android:textColor="#806653"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Penerima"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etRecipient"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Masukkan nama penerima"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#3E2723"
            android:textColorHint="#A1887F"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nomor Telepon"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Contoh: 081234567890"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#3E2723"
            android:textColorHint="#A1887F"
            android:inputType="phone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat Lengkap"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Nama jalan, nomor rumah, RT/RW, dan patokan"
            android:gravity="top"
            android:padding="14dp"
            android:textColor="#3E2723"
            android:textColorHint="#A1887F"
            android:inputType="textPostalAddress|textMultiLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kota / Kecamatan"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Masukkan kota atau kecamatan"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#3E2723"
            android:textColorHint="#A1887F"
            android:inputType="textCapWords" />

        <Button
            android:id="@+id/btnSaveAddress"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="#70452F"
            android:text="Simpan dan Lanjutkan"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
